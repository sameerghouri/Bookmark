{
  "info": {
    "_postman_id": "b7c1a6e2-4f8a-4c1e-9d3a-2e5f6a7b8c9d",
    "name": "Bookmark Manager API",
    "description": "Collection for the Bookmark Manager backend. Run the folders top to bottom; the Create request stores the new bookmark id in the `bookmarkId` collection variable used by the other requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "bookmarkId",
      "value": ""
    },
    {
      "key": "tag",
      "value": "react"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('returns success true', () => pm.expect(pm.response.json().success).to.eql(true));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "Create bookmark",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('returns the created bookmark', () => {",
              "  pm.expect(body.success).to.eql(true);",
              "  pm.expect(body.data.title).to.eql('React Docs');",
              "  pm.expect(body.data.isFavorite).to.eql(false);",
              "});",
              "pm.collectionVariables.set('bookmarkId', body.data._id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"React Docs\",\n  \"url\": \"https://react.dev\",\n  \"tag\": \"react\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/bookmarks",
          "host": ["{{baseUrl}}"],
          "path": ["bookmarks"]
        }
      }
    },
    {
      "name": "Create invalid bookmark (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 400', () => pm.response.to.have.status(400));",
              "pm.test('returns an error message', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.success).to.eql(false);",
              "  pm.expect(body.error).to.be.a('string');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Missing URL\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/bookmarks",
          "host": ["{{baseUrl}}"],
          "path": ["bookmarks"]
        }
      }
    },
    {
      "name": "List all bookmarks",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('returns an array', () => pm.expect(body.data).to.be.an('array'));",
              "pm.test('sorted newest first', () => {",
              "  const dates = body.data.map((bookmark) => new Date(bookmark.createdAt).getTime());",
              "  const sorted = [...dates].sort((a, b) => b - a);",
              "  pm.expect(dates).to.eql(sorted);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/bookmarks",
          "host": ["{{baseUrl}}"],
          "path": ["bookmarks"]
        }
      }
    },
    {
      "name": "List bookmarks by tag",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('every bookmark has the requested tag', () => {",
              "  pm.expect(body.data.every((bookmark) => bookmark.tag === pm.collectionVariables.get('tag'))).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/bookmarks?tag={{tag}}",
          "host": ["{{baseUrl}}"],
          "path": ["bookmarks"],
          "query": [{ "key": "tag", "value": "{{tag}}" }]
        }
      }
    },
    {
      "name": "Toggle favorite",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('isFavorite is true', () => pm.expect(pm.response.json().data.isFavorite).to.eql(true));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/bookmarks/{{bookmarkId}}/favorite",
          "host": ["{{baseUrl}}"],
          "path": ["bookmarks", "{{bookmarkId}}", "favorite"]
        }
      }
    },
    {
      "name": "Update bookmark",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('title was updated', () => pm.expect(pm.response.json().data.title).to.eql('React Documentation'));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"React Documentation\",\n  \"url\": \"https://react.dev/learn\",\n  \"tag\": \"frontend\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/bookmarks/{{bookmarkId}}",
          "host": ["{{baseUrl}}"],
          "path": ["bookmarks", "{{bookmarkId}}"]
        }
      }
    },
    {
      "name": "Delete bookmark",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('returns the deleted id', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.data.id).to.eql(pm.collectionVariables.get('bookmarkId'));",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/bookmarks/{{bookmarkId}}",
          "host": ["{{baseUrl}}"],
          "path": ["bookmarks", "{{bookmarkId}}"]
        }
      }
    },
    {
      "name": "Delete missing bookmark (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 404', () => pm.response.to.have.status(404));",
              "pm.test('returns success false', () => pm.expect(pm.response.json().success).to.eql(false));"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/bookmarks/{{bookmarkId}}",
          "host": ["{{baseUrl}}"],
          "path": ["bookmarks", "{{bookmarkId}}"]
        }
      }
    }
  ]
}
